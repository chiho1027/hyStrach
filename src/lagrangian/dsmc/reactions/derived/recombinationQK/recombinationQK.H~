#ifndef recombinationQK_H
#define recombinationQK_H

#include "dsmcReaction.H"
#include "vector.H"
#include "fvMesh.H"
#include "volFields.H"
#include "dsmcCloud.H"


// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

namespace Foam
{

/*---------------------------------------------------------------------------*\
                           Class recombinationQK Declaration
\*---------------------------------------------------------------------------*/

class recombinationQK
:
   public virtual dsmcReaction
{

protected:
    // Protected data

        //- sub-Dictionary containing the properties
        dictionary propsDict_;

        label posMolReactant_;//??
        
        labelList thirdBodyId_;

        labelList nTotRecombinationReactions_;
        labelList nRecombinationReactionsPerTimeStep_;

        //- Id of the product
        label productIdRecombination_;

        //- String to print for the exchange reaction
        wordList recombinationStr_;
        
        scalarList aCoeff_;
        scalarList bCoeff_;
        
        scalar heatOfReactionRecombinationJoules_;

        // remove if not used for heat bath
        scalar volume_;
        
        scalarList rhoC_;// thirdBody number density

        // Protected Member Functions
        virtual void setProperties();

           //label selectThirdBody();

        void postReactionVibrationalRedistribution
	(
	 const scalarList thetaVProduct,
	 const scalar TMacro,
	 const scalar recombOmega,
	 labelList& vibLevel,
	 scalar& Ec
	);

	scalar normalizedIncomGamma
	(
	 const scalar a,
	 const scalar x
	);

        void testRecombination
        (
            const dsmcParcel& p,
	    const dsmcParcel& q,
            const scalar translationalEnergy,
            const scalar omegaPQ,
	    const label  nR,
            scalar& reactionProbability
        );
        
        void recombination
	(
	  dsmcParcel& p,
	  dsmcParcel& q,
	  const label nR,
	  const scalar translationalEnergy
	);
  
        void computeDensity(const label nR);

public:

    //- Runtime type information
    TypeName("recombinationQK");

    // Constructors

        //- Construct from components
        recombinationQK
        (
	    Time& t,
            dsmcCloud& cloud,
            const dictionary& dict
        );
    
        // Destructor
        ~recombinationQK();
    
    // Member Functions

        // initial configuration - read in properties from chemReactDict
        void initialConfiguration();

        // apply a reaction between parcel p and q
        void reaction
        (
            dsmcParcel& p,
            dsmcParcel& q,
	    const label candidateId
            //const DynamicList<label>& candidateList,
            //const List<DynamicList<label> >& candidateSubList,
            //const label& candidateP,
            //const List<label>& whichSubCell
        );

        void reaction(dsmcParcel& p, dsmcParcel& q);

        // return bool if molecules belong to this reaction model
        virtual bool tryReactMolecules(const label& typeIdP, const label& typeIdQ);

        // Access

        virtual label nReactionsPerTimeStep() const
        {
	  return std::accumulate
          (
	    nRecombinationReactionsPerTimeStep_.begin(),
	    nRecombinationReactionsPerTimeStep_.end(),
	    0
	  );
	}
  
        virtual void outputResults(const label& counterIndex);

};


// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

